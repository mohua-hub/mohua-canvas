{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mohua Canvas",
  "version": "0.1.3",
  "identifier": "com.mohua.canvas",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev -- -H 127.0.0.1",
      "cwd": "../web"
    },
    "beforeBuildCommand": {
      "script": "node scripts/desktop.mjs prepare",
      "cwd": ".."
    },
    "devUrl": "http://127.0.0.1:3000",
    "frontendDist": "../desktop/splash"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "dragDropEnabled": false,
        "title": "墨画画布",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/node"
    ],
    "resources": {
      "resources/": "resources/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": false
    }
  }
}
